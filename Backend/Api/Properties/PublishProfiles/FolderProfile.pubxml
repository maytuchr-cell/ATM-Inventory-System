<Project>
  <!--
    In Visual Studio: right-click the Api project -> Publish -> pick this profile ("FolderProfile") -> Publish.
    Publishes to ..\..\publish\api (relative to Backend\Api), and Api.csproj's CopyFrontendAfterPublish
    target automatically copies the static Frontend site to ..\..\publish\ (the sibling site-root folder)
    in the same step — one click gets you the full IIS-ready `publish\` package.

    Framework-dependent (not self-contained) — the target IIS server needs the ASP.NET Core 9
    Hosting Bundle installed (it already is, on the UAT server). Framework-dependent keeps the
    publish output small and matches web.config's processPath="dotnet". Don't set SelfContained
    or RuntimeIdentifier here unless you also update web.config to processPath=".\Api.exe".
  -->
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0</TargetFramework>
    <PublishDir>..\..\publish\api\</PublishDir>
    <SelfContained>false</SelfContained>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>